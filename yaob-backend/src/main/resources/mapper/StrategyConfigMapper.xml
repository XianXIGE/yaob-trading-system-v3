<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yaob.mapper.StrategyConfigMapper">
    <select id="findByUserId" resultType="StrategyConfig">
        SELECT * FROM strategy_configs WHERE user_id = #{userId}
    </select>
    <select id="findByUserIdAndStrategy" resultType="StrategyConfig">
        SELECT * FROM strategy_configs WHERE user_id = #{userId} AND strategy = #{strategy}
    </select>
</mapper>
