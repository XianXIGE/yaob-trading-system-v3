<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yaob.mapper.ExcludedSymbolMapper">
    <select id="findByUserId" resultType="ExcludedSymbol">
        SELECT * FROM excluded_symbols WHERE user_id = #{userId}
    </select>
    <select id="findByUserIdAndCategory" resultType="ExcludedSymbol">
        SELECT * FROM excluded_symbols WHERE user_id = #{userId} AND category = #{category}
    </select>
</mapper>
